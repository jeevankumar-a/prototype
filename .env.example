# Copy to .env. Do not commit credentials.
GEMINI_API_KEY=replace-me
LITELLM_MASTER_KEY=sk-replace-with-long-random-admin-secret
# Created by the provisioning command in README, not by merely setting this value.
LITELLM_VIRTUAL_KEY=
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me
LANGFUSE_HOST=https://cloud.langfuse.com
# Fine-grained token limited to the target repository, with Contents read/write.
GITHUB_PERSONAL_ACCESS_TOKEN=replace-me
# Official native GitHub MCP server executable.
GITHUB_MCP_SERVER=.local\github-mcp\github-mcp-server.exe
TARGET_REPO=owner/repository
TARGET_BRANCH=main
TARGET_DIRECTORY=diagrams
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
POLL_INTERVAL_SECONDS=5
# Dedicated PostgreSQL database for LiteLLM virtual keys and budgets.
DATABASE_URL=postgresql://litellm:replace-me@localhost:5432/litellm
